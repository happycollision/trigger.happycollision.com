#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

step_started=$SECONDS
echo "[setup] Ensuring mise and the pinned Node.js toolchain are installed..."
mise_bin="$HOME/.local/bin/mise"
if [[ ! -x "$mise_bin" ]]; then
  curl --fail --location --silent --show-error https://mise.run | sh
fi
"$mise_bin" install
eval "$("$mise_bin" activate bash)"
echo "[setup] Toolchain ready in $((SECONDS - step_started))s ($(node --version), npm $(npm --version))."

profile_marker="# trigger.happycollision.com mise toolchain"
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
  cat >> "$HOME/.bash_profile" <<EOF

$profile_marker
if [[ -x "$mise_bin" && ( "\$PWD" == "$repo_root" || "\$PWD" == "$repo_root/"* ) ]]; then
  eval "\$("$mise_bin" activate bash)"
fi
EOF
fi

step_started=$SECONDS
echo "[setup] Installing npm dependencies..."
npm install --prefer-offline --no-audit --no-fund
echo "[setup] Dependencies ready in $((SECONDS - step_started))s."
